<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!--
  Living Market - Einstellungen und Grundwerte für den Bedarf der Verkaufsstationen

  Beim ersten Start wird diese Datei nach
      Dokumente/My Games/FarmingSimulator2025/modSettings/FS25_LivingMarket_config.xml
  kopiert. Dort kannst du die Werte ändern; die Kopie wird nicht überschrieben.
  Um auf die Standardwerte zurückzugehen: die Kopie löschen.
  Bringt ein Update eine neue Version dieser Datei, wird die Kopie als ..._config_old.xml gesichert
  und neu angelegt (eigene Änderungen danach von Hand übernehmen).

  max            = höchster Bedarf je Station und Ware in Litern
  refillPerMonth = Anteil vom Maximum, der sich je Spielmonat wieder auffüllt (0.40 = 40 %)
                   (wird gleichmäßig auf die Spielstunden des Monats verteilt)
  fillType name  = interner Name der Ware (wie in fillTypes.xml). Unbekannte Namen werden übersprungen.
  Waren, die in keiner Gruppe stehen, werden automatisch zugeordnet (siehe <autoGroups>),
  alles Übrige bekommt die Werte von <default>. Ausdrücklich eingetragene Waren haben immer Vorrang.

  Fehlt ein Abschnitt oder ein Wert, gilt der Standardwert des Mods.
  Anteile werden als Dezimalzahl mit Punkt angegeben (0.25 = 25 %).
-->
<livingMarket version="7">
    <default max="60000" refillPerMonth="0.30"/>

    <!-- Marktlage: Preis abhängig vom offenen Bedarf
         fullShare = ab diesem offenen Anteil voller Preis (0.50 = 50 %)
         minShare  = ab diesem offenen Anteil und darunter der Tiefstpreis
         minFactor = Tiefstpreis als Anteil vom Normalpreis (0.50 = -50 %)
         curve     = Verlauf dazwischen: 1 = gleichmäßig, 2 = erst langsam, dann immer schneller -->
    <marketPrice fullShare="0.50" minShare="0.10" minFactor="0.50" curve="2"/>

    <!-- Kleine Schwankungen je Station und Ware, zu jedem Monat neu ausgewürfelt
         demand = Bedarf (Maximum) ±10 %, refill = Auffüllung ±10 %; 0 = aus -->
    <variation demand="0.10" refill="0.10"/>

    <!-- Marktereignisse
         enabled            = false schaltet neue Ereignisse ab
         minActive/maxActive = so viele Ereignisse laufen etwa gleichzeitig (jeden Monat neu gewählt)
         minMonths/maxMonths = Dauer eines Ereignisses in Monaten
         announceMonths     = marktweite Ereignisse (Gefragt, Flaute) so viele Monate vorher ankündigen

         Je Ereignis:
         weight             = Häufigkeit im Verhältnis zu den anderen (0 = kommt nicht vor)
         minPrice/maxPrice  = Preisänderung ±10..25 %
         demandFactor       = Faktor auf den Bedarf (1.5 = 150 %)
         minRefill/maxRefill = Änderung der Auffüllung ±10..50 %
         palletOnly         = nur bei Palettenware

         shortage   = Engpass (eine Station, Preis rauf, mehr Bedarf)
         surplus    = Überangebot (eine Station, Preis runter, weniger Bedarf)
         boom       = Gefragt (alle Stationen, angekündigt)
         slump      = Flaute (alle Stationen, angekündigt)
         demand     = Nachgefragt (eine Station, füllt schneller auf)
         slowSeller = Ladenhüter (eine Station, füllt langsamer auf) -->
    <events enabled="true" minActive="10" maxActive="20" minMonths="1" maxMonths="2" announceMonths="1">
        <event type="shortage"   weight="0.30"  minPrice="0.10" maxPrice="0.25" demandFactor="1.5"/>
        <event type="surplus"    weight="0.25"  minPrice="0.10" maxPrice="0.25" demandFactor="0.6"/>
        <event type="boom"       weight="0.125" minPrice="0.10" maxPrice="0.25" demandFactor="1.3"/>
        <event type="slump"      weight="0.125" minPrice="0.10" maxPrice="0.25" demandFactor="0.7"/>
        <event type="demand"     weight="0.12"  minRefill="0.10" maxRefill="0.50"/>
        <event type="slowSeller" weight="0.08"  minRefill="0.10" maxRefill="0.50" palletOnly="true"/>
    </events>

    <!-- Lieferverträge (Ausschreibungen der Stationen)
         enabled            = false schaltet neue Ausschreibungen ab
         minOffers/maxOffers = so viele offene Ausschreibungen gleichzeitig (jeden Monat neu gewählt)
         offerMonths        = nicht angenommene Ausschreibung verfällt nach so vielen Monaten (spätestens zur Frist)
         minMonths/maxMonths = Frist in Monaten, gerechnet ab Erscheinen der Ausschreibung
         minShare/maxShare  = Menge als Anteil vom Maximum der Station (auf 1000 l abgerundet)
         minMarkup/maxMarkup = Grundaufschlag auf den Marktpreis des Monats
         reputationMarkup   = zusätzlicher Aufschlag bei bestem Ansehen (5 Sterne)
         eventMarkup        = zusätzlicher Aufschlag bei Engpass/Nachgefragt an der Station
         maxTotalMarkup     = Aufschlag insgesamt höchstens (0.10 = 10 %)
         bonusRate          = Bonus bei vollständiger Lieferung (Anteil vom Vertragswert)
         penaltyRate        = Strafe bei Nichterfüllung/Kündigung (Anteil vom Wert der fehlenden Menge)
         maxActivePerFarm   = laufende Verträge je Hof
         Ansehen je Hof und Station 0..100 (Start 50 = 3 Sterne, je 20 Punkte ein Stern):
         repFulfilled/repFailed = Änderung bei erfülltem/gescheitertem Vertrag
         repDriftPerMonth   = so viele Punkte je Monat zurück Richtung 50
         repMinStars        = darunter bietet die Station dem Hof keine Verträge an -->
    <contracts enabled="true" minOffers="3" maxOffers="6" offerMonths="1" minMonths="1" maxMonths="3"
               minShare="0.30" maxShare="0.80" minMarkup="0.02" maxMarkup="0.05" reputationMarkup="0.03"
               eventMarkup="0.02" maxTotalMarkup="0.10" bonusRate="0.20" penaltyRate="0.50" maxActivePerFarm="3"
               repFulfilled="2" repFailed="20" repDriftPerMonth="1" repMinStars="2"/>

    <!-- Automatische Zuordnung für Karten- und Mod-Waren, die unten nicht aufgeführt sind:
         1. Schwad/Halmgut (…_WINDROW)          -> windrowGroup
         2. Milch (lose)                         -> milkGroup
         3. Feldfrucht (Erntegut einer Frucht)   -> fruitGroup
         4. Paletten-/Stückware nach Grundpreis je 1000 l -> erste passende priceTier (von oben)
         5. alles andere (Schüttgut, Flüssiges)  -> <default>
         Betriebsmittel (Diesel, Dünger, Saatgut ...) bekommen immer <default>.
         enabled="false" schaltet die Automatik ab. -->
    <autoGroups enabled="true" fruitGroup="grain" windrowGroup="forage" milkGroup="milk">
        <priceTier minPrice="4000" group="premium"/>
        <priceTier minPrice="1500" group="food"/>
        <priceTier minPrice="0"    group="intermediate"/>
    </autoGroups>

    <groups>
        <group name="grain" title="Getreide &amp; Ölsaaten" max="500000" refillPerMonth="0.40">
            <fillType name="WHEAT"/> <fillType name="BARLEY"/> <fillType name="OAT"/> <fillType name="RYE"/>
            <fillType name="TRITICALE"/> <fillType name="SPELT"/> <fillType name="SUMMERWHEAT"/> <fillType name="SUMMERBARLEY"/>
            <fillType name="CANOLA"/> <fillType name="SUNFLOWER"/> <fillType name="SOYBEAN"/> <fillType name="MAIZE"/>
            <fillType name="SORGHUM"/> <fillType name="RICE"/> <fillType name="RICELONGGRAIN"/> <fillType name="BUCKWHEAT"/>
            <fillType name="HEMP"/> <fillType name="LINSEED"/> <fillType name="MUSTARD"/> <fillType name="POPPY"/>
            <fillType name="LENTILS"/> <fillType name="PEA"/> <fillType name="CHICKPEAS"/> <fillType name="BROADBEAN"/>
            <fillType name="MILLET"/> <fillType name="QUINOA"/>
        </group>

        <group name="roots" title="Hackfrüchte" max="400000" refillPerMonth="0.40">
            <fillType name="POTATO"/> <fillType name="SUGARBEET"/> <fillType name="SUGARBEET_CUT"/> <fillType name="BEETROOT"/>
            <fillType name="CARROT"/> <fillType name="PARSNIP"/> <fillType name="ONION"/> <fillType name="SUGARCANE"/>
        </group>

        <group name="forage" title="Futter &amp; Halmgut" max="160000" refillPerMonth="0.30">
            <fillType name="GRASS_WINDROW"/> <fillType name="DRYGRASS_WINDROW"/> <fillType name="SILAGE"/> <fillType name="STRAW"/>
            <fillType name="CHAFF"/> <fillType name="FIELDGRASS"/> <fillType name="ALFALFA_WINDROW"/> <fillType name="DRYALFALFA_WINDROW"/>
            <fillType name="CLOVER_WINDROW"/> <fillType name="DRYCLOVER_WINDROW"/> <fillType name="FORAGE"/> <fillType name="FORAGE_MIXING"/>
            <fillType name="HAY_PELLETS"/> <fillType name="STRAW_PELLETS"/> <fillType name="SOYBEANSTRAW"/> <fillType name="FLAX_WINDROW"/>
            <fillType name="HEMP_WINDROW"/> <fillType name="PIGFOOD"/>
        </group>

        <group name="wood" title="Holz" max="200000" refillPerMonth="0.30">
            <fillType name="WOODCHIPS"/> <fillType name="WOOD"/> <fillType name="ROUNDBALE_WOOD"/> <fillType name="BARKMULCH"/>
        </group>

        <group name="milk" title="Milch" max="120000" refillPerMonth="0.60">
            <fillType name="MILK"/> <fillType name="GOATMILK"/> <fillType name="BUFFALOMILK"/>
        </group>

        <group name="intermediate" title="Zwischenprodukte" max="80000" refillPerMonth="0.35">
            <fillType name="FLOUR"/> <fillType name="SUGAR"/> <fillType name="SUNFLOWER_OIL"/> <fillType name="CANOLA_OIL"/>
            <fillType name="OLIVE_OIL"/> <fillType name="RICE_OIL"/> <fillType name="BUTTER"/> <fillType name="CREAM"/>
            <fillType name="BRAN"/> <fillType name="RICEFLOUR"/> <fillType name="BOARDS"/> <fillType name="PLANKS"/>
            <fillType name="WOODBEAM"/> <fillType name="CEMENT"/> <fillType name="CEMENTBRICKS"/> <fillType name="ROOFPLATES"/>
            <fillType name="PAPERROLL"/> <fillType name="CARTONROLL"/> <fillType name="FABRIC"/> <fillType name="THREAD"/>
        </group>

        <group name="food" title="Lebensmittel" max="60000" refillPerMonth="0.30">
            <fillType name="BREAD"/> <fillType name="CAKE"/> <fillType name="CHEESE"/> <fillType name="GRAPEJUICE"/>
            <fillType name="CEREAL"/> <fillType name="NOODLESOUP"/> <fillType name="POTATOCHIPS"/> <fillType name="RAISINS"/>
            <fillType name="SUGARBEET_SYRUP"/>
        </group>

        <group name="special" title="Tierprodukte &amp; Spezielles" max="30000" refillPerMonth="0.25">
            <fillType name="EGG"/> <fillType name="WOOL"/> <fillType name="HONEY"/> <fillType name="GRAPE"/>
            <fillType name="OLIVE"/> <fillType name="SPINACH"/> <fillType name="TOMATO"/> <fillType name="LETTUCE"/>
            <fillType name="STRAWBERRY"/>
        </group>

        <group name="premium" title="Hochwertige Endprodukte" max="20000" refillPerMonth="0.20">
            <fillType name="CHOCOLATE"/> <fillType name="CLOTHES"/> <fillType name="FURNITURE"/> <fillType name="PREFABWALL"/>
            <fillType name="BATHTUB"/> <fillType name="BARREL"/> <fillType name="BUCKET"/>
        </group>
    </groups>
</livingMarket>
