<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Oben: eine Zeile pro Ware mit bester Station. Unten: alle Stationen der gewählten Ware. -->
<GUI name="DynamicMarketFrame">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="gui.icon_ingameMenu_options"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_dynamicMarket_title"/>

            <!-- Suchfeld rechtsbündig neben dem Titel -->
            <TextInput profile="dm_searchInput" id="searchInput" onTextChanged="onSearchTextChanged" onEnterPressed="onSearchEnter" focusOnHighlight="true">
                <ThreePartBitmap profile="fs25_textInputBg"/>
                <Bitmap profile="fs25_textInputIconBox">
                    <Bitmap profile="fs25_textInputIcon"/>
                </Bitmap>
                <Text profile="dm_searchHint" id="searchHint" name="ignore" text="$l10n_dynamicMarket_searchHint"/>
            </TextInput>
        </GuiElement>

        <!-- Hinweistext oben -->
        <Text profile="dm_infoText" id="infoText" text=""/>

        <!-- ============ Obere Liste: Waren ============ -->
        <GuiElement profile="fs25_settingsControlsListHeader" absoluteSizeOffset="90px 0px" height="40px" position="0px -20px">
            <Text profile="fs25_settingsControlsListHeaderTitle" text="$l10n_dynamicMarket_colWare"/>
            <Text profile="fs25_settingsControlsListHeaderName" position="360px 10px" text="$l10n_dynamicMarket_colStock"/>
            <Text profile="fs25_settingsControlsListHeaderName" position="560px 10px" text="$l10n_dynamicMarket_colBestStation"/>
            <Text profile="fs25_settingsControlsListHeaderName" position="900px 10px" text="$l10n_dynamicMarket_colPrice"/>
            <Text profile="fs25_settingsControlsListHeaderName" position="1100px 10px" text="$l10n_dynamicMarket_colSellable"/>
            <Text profile="fs25_settingsControlsListHeaderName" position="1320px 10px" text="$l10n_dynamicMarket_colRevenue"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottomSoft" absoluteSizeOffset="-60px 0px" position="-10px 0px"/>
        </GuiElement>

        <!-- Höhe der Warenliste: zweiter Wert von absoluteSizeOffset (Platz für das Detailfenster) -->
        <SmoothList profile="fs25_settingsControlsList" id="wareList" absoluteSizeOffset="90px 400px" selectOnClick="false" onClick="onClickWare">
            <ListItem profile="dm_listItem" name="ware">
                <Text profile="dm_stationTitle" name="title" position="15px 0px"/>
                <Bitmap profile="fs25_settingsControlsSeparator" position="345px 0px"/>
                <Text profile="dm_rowText" name="stock" position="360px 0px"/>
                <Bitmap profile="fs25_settingsControlsSeparator" position="545px 0px"/>
                <Text profile="dm_rowText" name="station" position="560px 0px"/>
                <Bitmap profile="fs25_settingsControlsSeparator" position="885px 0px"/>
                <Text profile="dm_rowText" name="price" position="900px 0px"/>
                <Bitmap profile="fs25_settingsControlsSeparator" position="1085px 0px"/>
                <Text profile="dm_rowText" name="sellable" position="1100px 0px"/>
                <Bitmap profile="fs25_settingsControlsSeparator" position="1305px 0px"/>
                <Text profile="dm_rowText" name="revenue" position="1320px 0px"/>
            </ListItem>
        </SmoothList>

        <!-- Wird angezeigt, wenn die Warenliste leer ist -->
        <Text profile="dm_emptyText" id="emptyText" text="$l10n_dynamicMarket_none" visible="false"/>

        <!-- ============ Unteres Detailfenster: Stationen der gewählten Ware ============ -->
        <GuiElement profile="dm_detailPanel" id="detailPanel">
            <!-- Kopfzeile: Name der Ware steht in der ersten Spalte -->
            <Text profile="dm_detailHeaderTitle" id="detailTitle" text="$l10n_dynamicMarket_detailHint"/>
            <Text profile="dm_detailHeader" position="360px 0px" text="$l10n_dynamicMarket_colCategory"/>
            <Text profile="dm_detailHeader" position="600px 0px" text="$l10n_dynamicMarket_colPrice"/>
            <Text profile="dm_detailHeader" position="820px 0px" text="$l10n_dynamicMarket_colFreeMax"/>
            <Text profile="dm_detailHeader" position="1150px 0px" text="$l10n_dynamicMarket_colShare"/>

            <SmoothList profile="dm_detailList" id="detailList" selectOnClick="false">
                <ListItem profile="dm_listItem" name="station">
                    <Text profile="dm_rowText" name="name" position="15px 0px"/>
                    <Bitmap profile="fs25_settingsControlsSeparator" position="345px 0px"/>
                    <Text profile="dm_itemText" name="category" position="360px 0px"/>
                    <Bitmap profile="fs25_settingsControlsSeparator" position="585px 0px"/>
                    <Text profile="dm_rowText" name="price" position="600px 0px"/>
                    <Bitmap profile="fs25_settingsControlsSeparator" position="805px 0px"/>
                    <Text profile="dm_rowText" name="amount" position="820px 0px"/>
                    <Bitmap profile="fs25_settingsControlsSeparator" position="1135px 0px"/>
                    <Text profile="dm_rowText" name="share" position="1150px 0px"/>
                </ListItem>
            </SmoothList>
        </GuiElement>
    </GuiElement>

    <GUIProfiles>
        <Profile name="dm_infoText" extends="fs25_textDefault" with="anchorTopLeft">
            <size value="1200px 30px"/>
            <position value="50px 10px"/>
            <textAlignment value="left"/>
            <textSize value="16px"/>
            <textColor value="0.8 0.8 0.8 1"/>
        </Profile>

        <!-- Suchfeld: rechts in der Kopfzeile verankert. Breite/Abstand hier anpassen. -->
        <Profile name="dm_searchInput" extends="fs25_settingsTextInput">
            <anchors value="1 1 0.5 0.5"/>
            <pivot value="1 0.5"/>
            <position value="-20px 0px"/>
            <size value="420px 48px"/>
        </Profile>

        <Profile name="dm_searchHint" extends="fs25_textDefault" with="anchorMiddleLeft">
            <size value="320px 30px"/>
            <position value="15px 0px"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="middle"/>
            <textSize value="18px"/>
            <textColor value="0.55 0.55 0.55 1"/>
        </Profile>

        <!-- Detailfenster: am unteren Rand verankert, volle Breite, feste Höhe -->
        <Profile name="dm_detailPanel">
            <anchors value="0 1 0 0"/>
            <pivot value="0 0"/>
            <position value="0px 0px"/>
            <size value="100% 330px"/>
            <absoluteSizeOffset value="90px 0px"/>
        </Profile>

        <!-- Kopfzeile des Detailfensters: oben im Fenster -->
        <Profile name="dm_detailHeaderTitle" extends="fs25_textDefault">
            <anchors value="0 0 1 1"/>
            <pivot value="0 1"/>
            <position value="15px 0px"/>
            <size value="340px 36px"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="middle"/>
            <textSize value="18px"/>
            <textBold value="true"/>
            <textUpperCase value="true"/>
            <textColor value="1 1 1 1"/>
        </Profile>

        <Profile name="dm_detailHeader" extends="fs25_textDefault">
            <anchors value="0 0 1 1"/>
            <pivot value="0 1"/>
            <size value="300px 36px"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="middle"/>
            <textSize value="15px"/>
            <textBold value="true"/>
            <textUpperCase value="true"/>
            <textColor value="0.8 0.8 0.8 1"/>
        </Profile>

        <!-- Liste im Detailfenster: unten verankert, füllt das Fenster unter der Kopfzeile -->
        <Profile name="dm_detailList" extends="fs25_settingsControlsList">
            <anchors value="0 1 0 0"/>
            <pivot value="0 0"/>
            <position value="0px 0px"/>
            <size value="100% 290px"/>
            <absoluteSizeOffset value="0px 0px"/>
        </Profile>

        <!-- Zeilen: dunkel, beim Auswählen/Überfahren nur leicht aufgehellt -->
        <Profile name="dm_listItem" extends="fs25_settingsControlsListItem">
            <imageColor value="1 1 1 0.02"/>
            <imageFocusedColor value="1 1 1 0.10"/>
            <imageSelectedColor value="1 1 1 0.10"/>
            <imageHighlightedColor value="1 1 1 0.06"/>
            <imagePressedColor value="1 1 1 0.10"/>
        </Profile>

        <!-- Schrift: in allen Zuständen hell, damit sie nie auf hellem Grund verschwindet -->
        <Profile name="dm_rowText" extends="fs25_settingsControlsListName">
            <textColor value="1 1 1 1"/>
            <textFocusedColor value="1 1 1 1"/>
            <textSelectedColor value="1 1 1 1"/>
            <textHighlightedColor value="1 1 1 1"/>
            <textFocusedSelectedColor value="1 1 1 1"/>
            <textHighlightedSelectedColor value="1 1 1 1"/>
        </Profile>

        <Profile name="dm_stationTitle" extends="dm_rowText">
            <textBold value="true"/>
        </Profile>

        <Profile name="dm_itemText" extends="dm_rowText">
            <textColor value="0.8 0.8 0.8 1"/>
            <textFocusedColor value="0.8 0.8 0.8 1"/>
            <textSelectedColor value="0.8 0.8 0.8 1"/>
            <textHighlightedColor value="0.8 0.8 0.8 1"/>
            <textFocusedSelectedColor value="0.8 0.8 0.8 1"/>
            <textHighlightedSelectedColor value="0.8 0.8 0.8 1"/>
        </Profile>

        <Profile name="dm_emptyText" extends="fs25_textDefault" with="anchorTopLeft">
            <size value="1200px 40px"/>
            <position value="50px -120px"/>
            <textAlignment value="left"/>
            <textSize value="20px"/>
            <textColor value="0.8 0.8 0.8 1"/>
        </Profile>
    </GUIProfiles>
</GUI>
