<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Zweite Seite: alle laufenden und angekündigten Marktereignisse.
     Nutzt die Profile lm_* aus LivingMarketFrame.xml (wird vorher geladen). -->
<GUI name="LivingMarketEventsFrame">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="gui.icon_ingameMenu_options"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_livingMarket_eventsTitle"/>
        </GuiElement>

        <ThreePartBitmap profile="lm_tableFrameFull" id="eventFrame"/>

        <GuiElement profile="fs25_settingsControlsListHeader" absoluteSizeOffset="90px 0px" height="40px" position="0px -20px">
            <Text profile="lm_colHeader" position="20px 0px" text="$l10n_livingMarket_colEvent"/>
            <Text profile="lm_colHeader" position="204px 0px" text="$l10n_livingMarket_colWare"/>
            <Text profile="lm_colHeader" position="470px 0px" text="$l10n_livingMarket_colStationEv"/>
            <Text profile="lm_colHeaderRight" position="380px 0px" text="$l10n_livingMarket_colPrice"/>
            <Text profile="lm_colHeaderRight" position="500px 0px" text="$l10n_livingMarket_colDemand"/>
            <Text profile="lm_colHeader" position="1000px 0px" text="$l10n_livingMarket_colStart"/>
            <Text profile="lm_colHeader" position="1110px 0px" text="$l10n_livingMarket_colEnd"/>
            <Text profile="lm_colHeader" position="1220px 0px" text="$l10n_livingMarket_colStatus"/>
            <ThreePartBitmap profile="lm_headerLine"/>
        </GuiElement>

        <GuiElement profile="lm_eventsArea">
            <SmoothList profile="fs25_settingsControlsList" id="eventList" absoluteSizeOffset="90px 60px" selectOnClick="false">
                <ListItem profile="lm_listItem" name="event">
                    <ThreePartBitmap profile="lm_rowBg" name="bg"/>
                    <Text profile="lm_rowTextBold" name="type" position="20px 0px"/>
                    <Bitmap profile="lm_wareIcon" name="icon" position="170px 0px"/>
                    <Text profile="lm_rowTextBold" name="ware" position="204px 0px"/>
                    <Text profile="lm_rowText" name="station" position="470px 0px"/>
                    <Text profile="lm_rowTextRight" name="price" position="380px 0px"/>
                    <Text profile="lm_rowTextRight" name="demand" position="500px 0px"/>
                    <Text profile="lm_rowText" name="start" position="1000px 0px"/>
                    <Text profile="lm_rowText" name="end" position="1110px 0px"/>
                    <Text profile="lm_rowText" name="status" position="1220px 0px"/>
                </ListItem>
            </SmoothList>
            <GuiElement profile="lm_sliderArea">
                <ThreePartBitmap profile="lm_sliderBox">
                    <Slider profile="lm_slider" id="eventSlider" dataElementId="eventList"/>
                </ThreePartBitmap>
            </GuiElement>
        </GuiElement>

        <Text profile="lm_emptyText" id="emptyText" text="$l10n_livingMarket_noEvents" visible="false"/>
    </GuiElement>

    <GUIProfiles>
        <!-- ganze Seitenhöhe (kein Detailfenster) -->
        <Profile name="lm_eventsArea" extends="lm_wareArea">
            <absoluteSizeOffset value="0px 0px"/>
        </Profile>
        <Profile name="lm_tableFrameFull" extends="lm_tableFrameTop">
            <position value="37px -8px"/>
            <absoluteSizeOffset value="55px 4px"/>
        </Profile>
    </GUIProfiles>
</GUI>
