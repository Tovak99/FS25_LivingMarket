<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Oben: eine Zeile pro Ware mit bester Station. Unten: alle Stationen der gewählten Ware. -->
<GUI name="LivingMarketFrame">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="gui.icon_ingameMenu_options"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_livingMarket_title"/>

            <!-- Ansicht umschalten: Markt / Marktnachrichten / Verkäufe (aktive Ansicht grün; Position = rechte Textkante) -->
            <Button profile="lm_viewButton" id="viewMarketButton" position="-895px 0px" text="$l10n_livingMarket_viewMarket" onClick="onClickViewMarket"/>
            <Button profile="lm_viewButton" id="viewEventsButton" position="-730px 0px" text="$l10n_livingMarket_viewNews" onClick="onClickViewEvents"/>
            <Button profile="lm_viewButton" id="viewSalesButton" position="-601px 0px" text="$l10n_livingMarket_viewSales" onClick="onClickViewSales"/>
            <Button profile="lm_viewButton" id="viewContractsButton" position="-466px 0px" text="$l10n_livingMarket_viewContracts" onClick="onClickViewContracts"/>

            <!-- Filter (Alle / Lagernd / Favoriten): Klick schaltet weiter, links neben dem Suchfeld -->
            <Button profile="lm_filterButton" id="filterButton" text="" onClick="onClickFilter"/>
            <!-- Filter der Marktnachrichten (Alle / Lieferbar), gleiche Stelle, nur in dieser Ansicht -->
            <Button profile="lm_filterButton" id="eventFilterButton" text="" onClick="onClickEventFilter" visible="false"/>
            <!-- Filter der Verträge (Alle Angebote / Vorrätig): rechts am Platz des Suchfelds (dort ausgeblendet) -->
            <Button profile="lm_filterButton" id="contractFilterButton" position="-20px 0px" text="" onClick="onClickContractFilter" visible="false"/>

            <!-- Spielzeit und Datum (nur in den Marktnachrichten, an Stelle des Suchfelds) -->
            <Text profile="lm_clockText" id="clockText" text="" visible="false"/>

            <!-- Suchfeld rechtsbündig neben dem Titel -->
            <TextInput profile="lm_searchInput" id="searchInput" onTextChanged="onSearchTextChanged" onEnterPressed="onSearchEnter" focusOnHighlight="true">
                <ThreePartBitmap profile="fs25_textInputBg"/>
                <Bitmap profile="fs25_textInputIconBox">
                    <Bitmap profile="fs25_textInputIcon"/>
                </Bitmap>
                <Text profile="lm_searchHint" id="searchHint" name="ignore" text="$l10n_livingMarket_searchHint"/>
            </TextInput>
        </GuiElement>


        <!-- ============ Obere Liste: Waren ============ -->
        <!-- Rahmen hinter Kopfzeile und Warenliste -->
        <ThreePartBitmap profile="lm_tableFrameTop" id="wareFrame"/>

        <GuiElement profile="fs25_settingsControlsListHeader" id="wareHeader" absoluteSizeOffset="90px 0px" height="40px" position="0px -20px">
            <Button profile="lm_sortHeader" id="favHeader" position="14px 0px" text="*"/>
            <Button profile="lm_sortHeader" id="sortWare_title" position="66px 0px" text="$l10n_livingMarket_colWare" onClick="onClickSortHeader"/>
            <!-- Reihenfolge: * · Ware · Lager · Verkaufbar · Preis / 1000 l · Markt · Erlös · Beste Station · Bester Preis · Bester Monat -->
            <Button profile="lm_sortHeaderRight" id="sortWare_stock" position="-80px 0px" text="$l10n_livingMarket_colStock" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeaderRight" id="sortWare_sellable" position="55px 0px" text="$l10n_livingMarket_colSellable" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeaderRight" id="sortWare_price" position="180px 0px" text="$l10n_livingMarket_colPrice" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeaderRight" id="sortWare_deviation" position="295px 0px" text="$l10n_livingMarket_colDeviation" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeaderRight" id="sortWare_revenue" position="405px 0px" text="$l10n_livingMarket_colRevenue" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeader" id="sortWare_station" position="885px 0px" text="$l10n_livingMarket_colBestStation" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeaderRight" id="sortWare_highPrice" position="735px 0px" text="$l10n_livingMarket_colHighPrice" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeader" id="sortWare_bestMonth" position="1215px 0px" text="$l10n_livingMarket_colBestMonth" onClick="onClickSortHeader"/>
            <Bitmap profile="lm_sortArrow" id="wareSortArrow"/>
            <ThreePartBitmap profile="lm_headerLine"/>
        </GuiElement>

        <!-- Rahmen oben: ganze Seite minus Platz für das Detailfenster (lm_wareArea).
             Die Liste darin verhält sich wie vorher auf der ganzen Seite. -->
        <GuiElement profile="lm_wareArea" id="wareArea">
            <SmoothList profile="fs25_settingsControlsList" id="wareList" absoluteSizeOffset="90px 60px" selectOnClick="false" onClick="onClickWare">
                <ListItem profile="lm_listItem" name="ware">
                    <ThreePartBitmap profile="lm_rowBg" name="bg"/>
                    <Text profile="lm_rowTextBold" name="fav" position="14px 0px"/>
                    <Bitmap profile="lm_wareIcon" name="icon" position="32px 0px"/>
                    <Text profile="lm_rowTextBold" name="title" position="66px 0px"/>
                    <Text profile="lm_rowTextRight" name="stock" position="-80px 0px"/>
                    <Text profile="lm_rowTextRight" name="sellable" position="55px 0px"/>
                    <Text profile="lm_rowTextRight" name="price" position="180px 0px"/>
                    <!-- Pfeil direkt hinter dem Preis (rechte Kante Preis = 180 + 450 = 630) -->
                    <Bitmap profile="lm_trendIcon" name="trend" position="635px 0px"/>
                    <Text profile="lm_rowTextRight" name="deviation" position="295px 0px"/>
                    <Text profile="lm_rowTextRight" name="revenue" position="405px 0px"/>
                    <Text profile="lm_rowText" name="station" position="885px 0px"/>
                    <Text profile="lm_rowTextRight" name="highPrice" position="735px 0px"/>
                    <Text profile="lm_rowText" name="bestMonth" position="1215px 0px"/>
                </ListItem>
            </SmoothList>
            <!-- Scrollbalken -->
            <GuiElement profile="lm_sliderArea">
                <ThreePartBitmap profile="lm_sliderBox">
                    <Slider profile="lm_slider" id="wareSlider" dataElementId="wareList"/>
                </ThreePartBitmap>
            </GuiElement>
        </GuiElement>

        <!-- Wird angezeigt, wenn die Warenliste leer ist -->
        <Text profile="lm_emptyText" id="emptyText" text="$l10n_livingMarket_none" visible="false"/>

        <!-- ============ Unteres Detailfenster: Stationen der gewählten Ware ============ -->
        <!-- Rahmen unten (lm_detailArea): gleicher Aufbau wie oben – Kopfzeile + Liste -->
        <GuiElement profile="lm_detailArea" id="detailPanel">
            <!-- Rahmen hinter Kopfzeile und Detailliste -->
            <ThreePartBitmap profile="lm_tableFrameBottom" id="detailFrame"/>

            <GuiElement profile="fs25_settingsControlsListHeader" absoluteSizeOffset="90px 0px" height="40px" position="0px -20px">
                <!-- erste Spalte: Icon und Name der gewählten Ware -->
                <Bitmap profile="lm_wareIcon" id="detailIcon" position="32px 0px" visible="false"/>
                <Button profile="lm_sortHeader" id="detailTitle" position="66px 0px" text="$l10n_livingMarket_detailHint" onClick="onClickSortHeader"/>
                <!-- Spalten bündig unter der Warenliste: Liefermenge, Preis, Marktlage (unter Markt), Erlös -->
                <Button profile="lm_sortHeaderRight" id="sortDetail_amount" position="55px 0px" text="$l10n_livingMarket_colSellable" onClick="onClickSortHeader"/>
                <Button profile="lm_sortHeaderRight" id="sortDetail_price" position="180px 0px" text="$l10n_livingMarket_colPrice" onClick="onClickSortHeader"/>
                <Button profile="lm_sortHeaderRight" id="sortDetail_market" position="295px 0px" text="$l10n_livingMarket_colMarket" onClick="onClickSortHeader"/>
                <Button profile="lm_sortHeaderRight" id="sortDetail_revenue" position="405px 0px" text="$l10n_livingMarket_colRevenue" onClick="onClickSortHeader"/>
                <Button profile="lm_sortHeaderRight" id="sortDetail_max" position="550px 0px" text="$l10n_livingMarket_colMax" onClick="onClickSortHeader"/>
                <Button profile="lm_sortHeaderRight" id="sortDetail_share" position="660px 0px" text="$l10n_livingMarket_colShare" onClick="onClickSortHeader"/>
                <Button profile="lm_sortHeader" id="detailStarsHeader" position="1150px 0px" text="$l10n_livingMarket_colReputation"/>
                <Bitmap profile="lm_sortArrow" id="detailSortArrow"/>
                <ThreePartBitmap profile="lm_headerLine"/>
            </GuiElement>

            <SmoothList profile="fs25_settingsControlsList" id="detailList" absoluteSizeOffset="90px 60px" selectOnClick="false">
                <ListItem profile="lm_listItem" name="station">
                    <ThreePartBitmap profile="lm_rowBg" name="bg"/>
                    <Text profile="lm_rowTextBold" name="name" position="66px 0px"/>
                    <!-- Marktereignis der Station, z. B. "Engpass +18 %" (rechte Kante 400) -->
                    <Text profile="lm_rowTextRight" name="event" position="-50px 0px"/>
                    <Text profile="lm_rowTextRight" name="amount" position="55px 0px"/>
                    <Text profile="lm_rowTextRight" name="price" position="180px 0px"/>
                    <!-- Pfeil direkt hinter dem Preis (rechte Kante Preis = 180 + 450 = 630), wie oben -->
                    <Bitmap profile="lm_trendIcon" name="trend" position="635px 0px"/>
                    <Text profile="lm_rowTextRight" name="market" position="295px 0px"/>
                    <Text profile="lm_rowTextRight" name="revenue" position="405px 0px"/>
                    <Text profile="lm_rowTextRight" name="max" position="550px 0px"/>
                    <Text profile="lm_rowTextRight" name="share" position="660px 0px"/>
                    <Bitmap profile="lm_starsIcon" name="stars" position="1150px 0px"/>
                </ListItem>
            </SmoothList>
            <!-- Scrollbalken -->
            <GuiElement profile="lm_sliderArea">
                <ThreePartBitmap profile="lm_sliderBox">
                    <Slider profile="lm_slider" id="detailSlider" dataElementId="detailList"/>
                </ThreePartBitmap>
            </GuiElement>
        </GuiElement>

        <!-- ============ Ansicht Marktnachrichten (ganze Höhe, anfangs ausgeblendet) ============ -->
        <ThreePartBitmap profile="lm_tableFrameFull" id="eventFrame" visible="false"/>

        <GuiElement profile="fs25_settingsControlsListHeader" id="eventHeader" absoluteSizeOffset="90px 0px" height="40px" position="0px -20px" visible="false">
            <Button profile="lm_sortHeader" id="sortEvent_scope" position="20px 0px" text="$l10n_livingMarket_colScope" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeader" id="sortEvent_type" position="120px 0px" text="$l10n_livingMarket_colEvent" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeader" id="sortEvent_ware" position="264px 0px" text="$l10n_livingMarket_colWare" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeader" id="sortEvent_station" position="480px 0px" text="$l10n_livingMarket_colStationEv" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeaderRight" id="sortEvent_price" position="250px 0px" text="$l10n_livingMarket_colPrice" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeaderRight" id="sortEvent_demand" position="350px 0px" text="$l10n_livingMarket_colDemand" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeaderRight" id="sortEvent_refill" position="460px 0px" text="$l10n_livingMarket_colRefill" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeader" id="sortEvent_start" position="940px 0px" text="$l10n_livingMarket_colStart" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeader" id="sortEvent_finish" position="1090px 0px" text="$l10n_livingMarket_colEnd" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeader" id="sortEvent_status" position="1290px 0px" text="$l10n_livingMarket_colStatus" onClick="onClickSortHeader"/>
            <Bitmap profile="lm_sortArrow" id="eventSortArrow"/>
            <ThreePartBitmap profile="lm_headerLine"/>
        </GuiElement>

        <GuiElement profile="lm_eventsArea" id="eventArea" visible="false">
            <SmoothList profile="fs25_settingsControlsList" id="eventList" absoluteSizeOffset="90px 60px" selectOnClick="false">
                <ListItem profile="lm_listItem" name="event">
                    <ThreePartBitmap profile="lm_rowBg" name="bg"/>
                    <Text profile="lm_rowTextBold" name="scope" position="20px 0px"/>
                    <Text profile="lm_rowTextBold" name="type" position="120px 0px"/>
                    <Bitmap profile="lm_wareIcon" name="icon" position="230px 0px"/>
                    <Text profile="lm_rowTextBold" name="ware" position="264px 0px"/>
                    <Text profile="lm_rowText" name="station" position="480px 0px"/>
                    <Text profile="lm_rowTextRight" name="price" position="250px 0px"/>
                    <Text profile="lm_rowTextRight" name="demand" position="350px 0px"/>
                    <Text profile="lm_rowTextRight" name="refill" position="460px 0px"/>
                    <Text profile="lm_rowText" name="start" position="940px 0px"/>
                    <Text profile="lm_rowText" name="end" position="1090px 0px"/>
                    <Text profile="lm_rowText" name="status" position="1290px 0px"/>
                </ListItem>
            </SmoothList>
            <GuiElement profile="lm_sliderArea">
                <ThreePartBitmap profile="lm_sliderBox">
                    <Slider profile="lm_slider" id="eventSlider" dataElementId="eventList"/>
                </ThreePartBitmap>
            </GuiElement>
        </GuiElement>

        <Text profile="lm_emptyText" id="eventEmptyText" text="$l10n_livingMarket_noEvents" visible="false"/>

        <!-- ============ Ansicht Verkäufe (letzte 50 Verkäufe des eigenen Hofs) ============ -->
        <ThreePartBitmap profile="lm_tableFrameFull" id="saleFrame" visible="false"/>

        <GuiElement profile="fs25_settingsControlsListHeader" id="saleHeader" absoluteSizeOffset="90px 0px" height="40px" position="0px -20px" visible="false">
            <Button profile="lm_sortHeader" id="sortSale_time" position="20px 0px" text="$l10n_livingMarket_colTime" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeader" id="sortSale_ware" position="199px 0px" text="$l10n_livingMarket_colWare" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeader" id="sortSale_station" position="430px 0px" text="$l10n_livingMarket_colStationEv" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeaderRight" id="sortSale_amount" position="380px 0px" text="$l10n_livingMarket_colAmount" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeaderRight" id="sortSale_price" position="500px 0px" text="$l10n_livingMarket_colPrice" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeaderRight" id="sortSale_revenue" position="630px 0px" text="$l10n_livingMarket_colRevenue" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeaderRight" id="sortSale_market" position="750px 0px" text="$l10n_livingMarket_colMarket" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeader" id="sortSale_event" position="1230px 0px" text="$l10n_livingMarket_colEvent" onClick="onClickSortHeader"/>
            <Bitmap profile="lm_sortArrow" id="saleSortArrow"/>
            <ThreePartBitmap profile="lm_headerLine"/>
        </GuiElement>

        <GuiElement profile="lm_eventsArea" id="saleArea" visible="false">
            <SmoothList profile="fs25_settingsControlsList" id="saleList" absoluteSizeOffset="90px 60px" selectOnClick="false">
                <ListItem profile="lm_listItem" name="sale">
                    <ThreePartBitmap profile="lm_rowBg" name="bg"/>
                    <Text profile="lm_rowText" name="time" position="20px 0px"/>
                    <Bitmap profile="lm_wareIcon" name="icon" position="165px 0px"/>
                    <Text profile="lm_rowTextBold" name="ware" position="199px 0px"/>
                    <Text profile="lm_rowText" name="station" position="430px 0px"/>
                    <Text profile="lm_rowTextRight" name="amount" position="380px 0px"/>
                    <Text profile="lm_rowTextRight" name="price" position="500px 0px"/>
                    <Text profile="lm_rowTextRight" name="revenue" position="630px 0px"/>
                    <Text profile="lm_rowTextRight" name="market" position="750px 0px"/>
                    <Text profile="lm_rowText" name="event" position="1230px 0px"/>
                </ListItem>
            </SmoothList>
            <GuiElement profile="lm_sliderArea">
                <ThreePartBitmap profile="lm_sliderBox">
                    <Slider profile="lm_slider" id="saleSlider" dataElementId="saleList"/>
                </ThreePartBitmap>
            </GuiElement>
        </GuiElement>

        <Text profile="lm_emptyText" id="saleEmptyText" text="$l10n_livingMarket_noSales" visible="false"/>

        <!-- ============ Ansicht Verträge (Ausschreibungen + eigene laufende Verträge) ============ -->
        <ThreePartBitmap profile="lm_tableFrameFull" id="contractFrame" visible="false"/>

        <GuiElement profile="fs25_settingsControlsListHeader" id="contractHeader" absoluteSizeOffset="90px 0px" height="40px" position="0px -20px" visible="false">
            <Button profile="lm_sortHeader" id="contractHead_status" position="20px 0px" text="$l10n_livingMarket_colStatus"/>
            <Button profile="lm_sortHeader" id="contractHead_ware" position="154px 0px" text="$l10n_livingMarket_colWare"/>
            <Button profile="lm_sortHeader" id="contractHead_station" position="360px 0px" text="$l10n_livingMarket_colStationEv"/>
            <Button profile="lm_sortHeader" id="contractHead_stars" position="570px 0px" text="$l10n_livingMarket_colReputation"/>
            <Button profile="lm_sortHeaderRight" id="contractHead_amount" position="380px 0px" text="$l10n_livingMarket_colAmount"/>
            <Button profile="lm_sortHeaderRight" id="contractHead_price" position="490px 0px" text="$l10n_livingMarket_colPrice"/>
            <Button profile="lm_sortHeaderRight" id="contractHead_bonus" position="600px 0px" text="$l10n_livingMarket_colBonus"/>
            <Button profile="lm_sortHeader" id="contractHead_deadline" position="1075px 0px" text="$l10n_livingMarket_colDeadline"/>
            <Button profile="lm_sortHeaderRight" id="contractHead_stock" position="870px 0px" text="$l10n_livingMarket_colStock"/>
            <ThreePartBitmap profile="lm_headerLine"/>
        </GuiElement>

        <GuiElement profile="lm_eventsArea" id="contractArea" visible="false">
            <SmoothList profile="fs25_settingsControlsList" id="contractList" absoluteSizeOffset="90px 60px" selectOnClick="false" onClick="onClickContract">
                <ListItem profile="lm_listItem" name="contract">
                    <ThreePartBitmap profile="lm_rowBg" name="bg"/>
                    <Text profile="lm_rowTextBold" name="status" position="20px 0px"/>
                    <Bitmap profile="lm_wareIcon" name="icon" position="120px 0px"/>
                    <Text profile="lm_rowTextBold" name="ware" position="154px 0px"/>
                    <Text profile="lm_rowText" name="station" position="360px 0px"/>
                    <Bitmap profile="lm_starsIcon" name="stars" position="570px 0px"/>
                    <Text profile="lm_rowTextRight" name="amount" position="380px 0px"/>
                    <Text profile="lm_rowTextRight" name="price" position="490px 0px"/>
                    <Text profile="lm_rowTextRight" name="bonus" position="600px 0px"/>
                    <Text profile="lm_rowText" name="deadline" position="1075px 0px"/>
                    <Text profile="lm_rowTextRight" name="stock" position="870px 0px"/>
                </ListItem>
            </SmoothList>
            <GuiElement profile="lm_sliderArea">
                <ThreePartBitmap profile="lm_sliderBox">
                    <Slider profile="lm_slider" id="contractSlider" dataElementId="contractList"/>
                </ThreePartBitmap>
            </GuiElement>
        </GuiElement>

        <Text profile="lm_emptyText" id="contractEmptyText" text="$l10n_livingMarket_noContracts" visible="false"/>
    </GuiElement>

    <GUIProfiles>

        <!-- Suchfeld: rechts in der Kopfzeile verankert. Breite/Abstand hier anpassen. -->
        <Profile name="lm_searchInput" extends="fs25_settingsTextInput">
            <anchors value="1 1 0.5 0.5"/>
            <pivot value="1 0.5"/>
            <position value="-20px 0px"/>
            <size value="280px 48px"/>
            <!-- Text linksbündig wie der Hinweistext; mittig gesetzt zeichnet das Spiel
                 den Eingabe-Cursor über die Buchstaben (z. B. "Al$i" statt "Aldi") -->
            <textAlignment value="left"/>
            <textOffset value="15px 0px"/>
        </Profile>

        <Profile name="lm_clockText" extends="fs25_textDefault">
            <anchors value="1 1 0.5 0.5"/>
            <pivot value="1 0.5"/>
            <position value="-20px 0px"/>
            <size value="420px 40px"/>
            <textAlignment value="right"/>
            <textVerticalAlignment value="middle"/>
            <textSize value="20px"/>
            <textBold value="true"/>
            <textColor value="1 1 1 1"/>
        </Profile>

        <Profile name="lm_searchHint" extends="fs25_textDefault" with="anchorMiddleLeft">
            <size value="245px 30px"/>
            <position value="15px 0px"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="middle"/>
            <textSize value="18px"/>
            <textColor value="0.55 0.55 0.55 1"/>
        </Profile>

        <!-- Höhe des Detailfensters. Beide Werte unten müssen zusammenpassen:
             lm_wareArea lässt unten so viel frei, wie lm_detailArea hoch ist. -->
        <Profile name="lm_wareArea">
            <anchors value="0 1 1 1"/>
            <pivot value="0 1"/>
            <position value="0px 0px"/>
            <size value="100% 100%"/>
            <absoluteSizeOffset value="0px 190px"/>
        </Profile>

        <Profile name="lm_detailArea">
            <anchors value="0 1 0 0"/>
            <pivot value="0 0"/>
            <position value="0px 0px"/>
            <size value="100% 190px"/>
        </Profile>

        <!-- Spaltenköpfe linksbündig, damit sie über den Werten stehen -->
        <!-- Zeilenhintergrund ohne das Endstück (das ist ein Verlauf nach rechts) -->
        <Profile name="lm_rowBg" extends="fs25_settingsControlsListItemBg">
            <endImageSize value="0px 0px"/>
        </Profile>

        <!-- Tabellenrahmen: etwas hellere Fläche, die rundum ein Stück über Kopfzeile und Liste
             hinausragt. Maße aus Screenshots: Die Liste ist horizontal zentriert (Seitenbreite - 90,
             also 45px Rand je Seite); Kopfzeile beginnt 20px unter der Oberkante. -->
        <Profile name="lm_tableFrameTop" extends="lm_rowBg">
            <anchors value="0 1 0 1"/>
            <pivot value="0 0"/>
            <position value="37px 182px"/>
            <size value="100% 100%"/>
            <absoluteSizeOffset value="55px 194px"/>
        </Profile>

        <!-- Linie unter den Spaltenköpfen: genau so breit wie die Zeilen, ohne Verlauf -->
        <Profile name="lm_headerLine" extends="lm_rowBg">
            <anchors value="0 1 0 0"/>
            <pivot value="0 0"/>
            <position value="0px 0px"/>
            <size value="100% 2px"/>
            <absoluteSizeOffset value="0px 0px"/>
            <startImageSize value="0px 0px"/>
            <imageColor value="0.090 0.090 0.090 1"/>
            <imageFocusedColor value="0.090 0.090 0.090 1"/>
            <imageSelectedColor value="0.090 0.090 0.090 1"/>
            <imageHighlightedColor value="0.090 0.090 0.090 1"/>
        </Profile>

        <Profile name="lm_tableFrameBottom" extends="lm_rowBg">
            <anchors value="0 1 0 1"/>
            <pivot value="0 0"/>
            <position value="37px -8px"/>
            <size value="100% 100%"/>
            <absoluteSizeOffset value="55px 4px"/>
        </Profile>

        <!-- Scrollbalken: rechts im Tabellenrahmen, so hoch wie die Liste (60px unter der
             Oberkante des Bereichs, bis zur Unterkante). Breite/Abstand hier anpassen. -->
        <Profile name="lm_sliderArea">
            <anchors value="1 1 0 1"/>
            <pivot value="1 0"/>
            <position value="-26px 0px"/>
            <size value="14px 100%"/>
            <absoluteSizeOffset value="0px 60px"/>
        </Profile>

        <Profile name="lm_sliderBox" extends="fs25_sliderDockedBox">
            <anchors value="0 1 0 1"/>
            <pivot value="0 0"/>
            <position value="0px 0px"/>
            <size value="100% 100%"/>
            <absoluteSizeOffset value="0px 0px"/>
        </Profile>

        <Profile name="lm_slider" extends="fs25_sliderDocked">
            <anchors value="0 1 0 1"/>
            <pivot value="0 0"/>
            <position value="0px 0px"/>
            <size value="100% 100%"/>
            <absoluteSizeOffset value="0px 0px"/>
        </Profile>

        <!-- Spaltenköpfe mit derselben Geometrie wie die Zeilentexte, damit sie exakt über den Werten stehen -->
        <Profile name="lm_colHeader" extends="fs25_settingsControlsListName">
            <textAlignment value="left"/>
            <textBold value="true"/>
            <textUpperCase value="true"/>
            <textSize value="15px"/>
            <textColor value="0.85 0.85 0.85 1"/>
        </Profile>

        <Profile name="lm_colHeaderRight" extends="lm_colHeader">
            <textAlignment value="right"/>
        </Profile>

        <!-- Anklickbare Spaltenköpfe zum Sortieren: wie die Kopfzeilentexte, beim Überfahren weiß -->
        <Profile name="lm_sortHeader" extends="lm_colHeader">
            <!-- Buttons haben eigenen (weißen) Hintergrund: in allen Zuständen unsichtbar -->
            <imageColor value="0 0 0 0"/>
            <imageFocusedColor value="0 0 0 0"/>
            <imageHighlightedColor value="0 0 0 0"/>
            <imageSelectedColor value="0 0 0 0"/>
            <imagePressedColor value="0 0 0 0"/>
            <imageDisabledColor value="0 0 0 0"/>
            <textHighlightedColor value="1 1 1 1"/>
            <textFocusedColor value="0.85 0.85 0.85 1"/>
            <textSelectedColor value="0.85 0.85 0.85 1"/>
        </Profile>

        <!-- Sortierpfeil: wird im Code links neben den Text der sortierten Spalte gesetzt -->
        <Profile name="lm_sortArrow">
            <anchors value="0 0 0.5 0.5"/>
            <pivot value="0 0.5"/>
            <position value="0px 0px"/>
