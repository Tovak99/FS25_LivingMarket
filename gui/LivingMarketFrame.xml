<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Oben: eine Zeile pro Ware mit bester Station. Unten: alle Stationen der gewählten Ware. -->
<GUI name="LivingMarketFrame">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="gui.icon_ingameMenu_options"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_livingMarket_title"/>

            <!-- Suchfeld rechtsbündig neben dem Titel -->
            <TextInput profile="lm_searchInput" id="searchInput" onTextChanged="onSearchTextChanged" onEnterPressed="onSearchEnter" focusOnHighlight="true">
                <ThreePartBitmap profile="fs25_textInputBg"/>
                <Bitmap profile="fs25_textInputIconBox">
                    <Bitmap profile="fs25_textInputIcon"/>
                </Bitmap>
                <Text profile="lm_searchHint" id="searchHint" name="ignore" text="$l10n_livingMarket_searchHint"/>
            </TextInput>
        </GuiElement>

        <!-- Hinweistext oben -->
        <Text profile="lm_infoText" id="infoText" text=""/>

        <!-- ============ Obere Liste: Waren ============ -->
        <!-- Rahmen hinter Kopfzeile und Warenliste -->
        <ThreePartBitmap profile="lm_tableFrameTop" id="wareFrame"/>

        <GuiElement profile="fs25_settingsControlsListHeader" absoluteSizeOffset="90px 0px" height="40px" position="0px -20px">
            <Button profile="lm_sortHeader" id="sortWare_title" position="50px 0px" text="$l10n_livingMarket_colWare" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeaderRight" id="sortWare_stock" position="20px 0px" text="$l10n_livingMarket_colStock" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeader" id="sortWare_station" position="520px 0px" text="$l10n_livingMarket_colBestStation" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeaderRight" id="sortWare_price" position="510px 0px" text="$l10n_livingMarket_colPrice" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeaderRight" id="sortWare_sellable" position="720px 0px" text="$l10n_livingMarket_colSellable" onClick="onClickSortHeader"/>
            <Button profile="lm_sortHeaderRight" id="sortWare_revenue" position="940px 0px" text="$l10n_livingMarket_colRevenue" onClick="onClickSortHeader"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottomSoft" absoluteSizeOffset="-60px 0px" position="-10px 0px"/>
        </GuiElement>

        <!-- Rahmen oben: ganze Seite minus Platz für das Detailfenster (lm_wareArea).
             Die Liste darin verhält sich wie vorher auf der ganzen Seite. -->
        <GuiElement profile="lm_wareArea">
            <SmoothList profile="fs25_settingsControlsList" id="wareList" absoluteSizeOffset="90px 60px" selectOnClick="false" onClick="onClickWare">
                <ListItem profile="lm_listItem" name="ware">
                    <ThreePartBitmap profile="fs25_settingsControlsListItemBg" name="bg"/>
                    <Bitmap profile="lm_wareIcon" name="icon"/>
                    <Text profile="lm_rowTextBold" name="title" position="50px 0px"/>
                    <Text profile="lm_rowTextRight" name="stock" position="20px 0px"/>
                    <Text profile="lm_rowText" name="station" position="520px 0px"/>
                    <Text profile="lm_rowTextRight" name="price" position="510px 0px"/>
                    <Text profile="lm_rowTextRight" name="sellable" position="720px 0px"/>
                    <Text profile="lm_rowTextRight" name="revenue" position="940px 0px"/>
                </ListItem>
            </SmoothList>
            <!-- Scrollbalken -->
            <ThreePartBitmap profile="lm_sliderDockedBg">
                <ThreePartBitmap profile="fs25_sliderDockedBox">
                    <Slider profile="fs25_sliderDocked" id="wareSlider" dataElementId="wareList"/>
                </ThreePartBitmap>
            </ThreePartBitmap>
        </GuiElement>

        <!-- Wird angezeigt, wenn die Warenliste leer ist -->
        <Text profile="lm_emptyText" id="emptyText" text="$l10n_livingMarket_none" visible="false"/>

        <!-- ============ Unteres Detailfenster: Stationen der gewählten Ware ============ -->
        <!-- Rahmen unten (lm_detailArea): gleicher Aufbau wie oben – Kopfzeile + Liste -->
        <GuiElement profile="lm_detailArea" id="detailPanel">
            <!-- Rahmen hinter Kopfzeile und Detailliste -->
            <ThreePartBitmap profile="lm_tableFrameBottom" id="detailFrame"/>

            <GuiElement profile="fs25_settingsControlsListHeader" absoluteSizeOffset="90px 0px" height="40px" position="0px -20px">
                <!-- erste Spalte: Name der gewählten Ware -->
                <Button profile="lm_sortHeader" id="detailTitle" position="50px 0px" text="$l10n_livingMarket_detailHint" onClick="onClickSortHeader"/>
                <Button profile="lm_sortHeaderRight" id="sortDetail_price" position="510px 0px" text="$l10n_livingMarket_colPrice" onClick="onClickSortHeader"/>
                <Button profile="lm_sortHeaderRight" id="sortDetail_amount" position="770px 0px" text="$l10n_livingMarket_colFreeMax" onClick="onClickSortHeader"/>
                <Button profile="lm_sortHeaderRight" id="sortDetail_share" position="940px 0px" text="$l10n_livingMarket_colShare" onClick="onClickSortHeader"/>
                <ThreePartBitmap profile="fs25_lineSeparatorBottomSoft" absoluteSizeOffset="-60px 0px" position="-10px 0px"/>
            </GuiElement>

            <SmoothList profile="fs25_settingsControlsList" id="detailList" absoluteSizeOffset="90px 60px" selectOnClick="false">
                <ListItem profile="lm_listItem" name="station">
                    <ThreePartBitmap profile="fs25_settingsControlsListItemBg" name="bg"/>
                    <Text profile="lm_rowTextBold" name="name" position="50px 0px"/>
                    <Text profile="lm_rowTextRight" name="price" position="510px 0px"/>
                    <Text profile="lm_rowTextRight" name="amount" position="770px 0px"/>
                    <Text profile="lm_rowTextRight" name="share" position="940px 0px"/>
                </ListItem>
            </SmoothList>
            <!-- Scrollbalken -->
            <ThreePartBitmap profile="lm_sliderDockedBg">
                <ThreePartBitmap profile="fs25_sliderDockedBox">
                    <Slider profile="fs25_sliderDocked" id="detailSlider" dataElementId="detailList"/>
                </ThreePartBitmap>
            </ThreePartBitmap>
        </GuiElement>
    </GuiElement>

    <GUIProfiles>
        <Profile name="lm_infoText" extends="fs25_textDefault" with="anchorTopLeft">
            <size value="1200px 30px"/>
            <position value="50px 10px"/>
            <textAlignment value="left"/>
            <textSize value="16px"/>
            <textColor value="0.8 0.8 0.8 1"/>
        </Profile>

        <!-- Suchfeld: rechts in der Kopfzeile verankert. Breite/Abstand hier anpassen. -->
        <Profile name="lm_searchInput" extends="fs25_settingsTextInput">
            <anchors value="1 1 0.5 0.5"/>
            <pivot value="1 0.5"/>
            <position value="-20px 0px"/>
            <size value="420px 48px"/>
        </Profile>

        <Profile name="lm_searchHint" extends="fs25_textDefault" with="anchorMiddleLeft">
            <size value="320px 30px"/>
            <position value="15px 0px"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="middle"/>
            <textSize value="18px"/>
            <textColor value="0.55 0.55 0.55 1"/>
        </Profile>

        <!-- Höhe des Detailfensters. Beide Werte unten müssen zusammenpassen:
             lm_wareArea lässt unten so viel frei, wie lm_detailArea hoch ist. -->
        <Profile name="lm_wareArea">
            <anchors value="0 1 1 1"/>
            <pivot value="0 1"/>
            <position value="0px 0px"/>
            <size value="100% 100%"/>
            <absoluteSizeOffset value="0px 300px"/>
        </Profile>

        <Profile name="lm_detailArea">
            <anchors value="0 1 0 0"/>
            <pivot value="0 0"/>
            <position value="0px 0px"/>
            <size value="100% 300px"/>
        </Profile>

        <!-- Spaltenköpfe linksbündig, damit sie über den Werten stehen -->
        <!-- Tabellenrahmen: etwas hellere Fläche, die rundum ein Stück über Kopfzeile und Liste
             hinausragt. Maße aus Screenshots: Liste beginnt ca. 21px vom linken Seitenrand, ist
             Seitenbreite - 90 breit; Kopfzeile beginnt 20px unter der Oberkante. -->
        <Profile name="lm_tableFrameTop" extends="fs25_settingsControlsListItemBg">
            <anchors value="0 1 0 1"/>
            <pivot value="0 0"/>
            <position value="13px 292px"/>
            <size value="100% 100%"/>
            <absoluteSizeOffset value="74px 304px"/>
        </Profile>

        <Profile name="lm_tableFrameBottom" extends="fs25_settingsControlsListItemBg">
            <anchors value="0 1 0 1"/>
            <pivot value="0 0"/>
            <position value="13px -8px"/>
            <size value="100% 100%"/>
            <absoluteSizeOffset value="74px 4px"/>
        </Profile>

        <!-- Scrollbalken rechts im jeweiligen Rahmen -->
        <Profile name="lm_sliderDockedBg" extends="fs25_sliderDockedBg">
            <anchors value="1 1 0.5 0.5"/>
            <pivot value="1 0.5"/>
            <position value="75px -30px"/>
        </Profile>

        <!-- Spaltenköpfe mit derselben Geometrie wie die Zeilentexte, damit sie exakt über den Werten stehen -->
        <Profile name="lm_colHeader" extends="fs25_settingsControlsListName">
            <textAlignment value="left"/>
            <textBold value="true"/>
            <textUpperCase value="true"/>
            <textSize value="15px"/>
            <textColor value="0.85 0.85 0.85 1"/>
        </Profile>

        <Profile name="lm_colHeaderRight" extends="lm_colHeader">
            <textAlignment value="right"/>
        </Profile>

        <!-- Anklickbare Spaltenköpfe zum Sortieren: wie die Kopfzeilentexte, beim Überfahren weiß -->
        <Profile name="lm_sortHeader" extends="lm_colHeader">
            <textHighlightedColor value="1 1 1 1"/>
            <textFocusedColor value="0.85 0.85 0.85 1"/>
            <textSelectedColor value="0.85 0.85 0.85 1"/>
        </Profile>

        <Profile name="lm_sortHeaderRight" extends="lm_sortHeader">
            <textAlignment value="right"/>
        </Profile>

        <!-- Zeilen wie im Vorbild: abwechselnd dunkel/heller, ausgewählt in LS-Grün -->
        <!-- Zeilenhöhe: zweiter Wert von size (Spielstandard ca. 45px) -->
        <Profile name="lm_listItem" extends="fs25_settingsControlsListItem">
            <size value="100% 34px"/>
            <imageColor value="0.09 0.09 0.09 1"/>
            <alternateBackgroundColor value="0.14 0.14 0.14 1"/>
            <imageHighlightedColor value="0.20 0.20 0.20 1"/>
            <imageFocusedColor value="0.47 0.64 0.11 1"/>
            <imageSelectedColor value="0.47 0.64 0.11 1"/>
            <imagePressedColor value="0.47 0.64 0.11 1"/>
        </Profile>

        <!-- Icon der Ware links in der Zeile -->
        <Profile name="lm_wareIcon">
            <anchors value="0 0 0.5 0.5"/>
            <pivot value="0 0.5"/>
            <position value="12px 0px"/>
            <size value="22px 22px"/>
            <imageColor value="1 1 1 1"/>
            <imageSelectedColor value="1 1 1 1"/>
            <imageFocusedColor value="1 1 1 1"/>
            <imageHighlightedColor value="1 1 1 1"/>
        </Profile>

        <!-- Schrift: hell, in der grünen (ausgewählten) Zeile dunkel -->
        <Profile name="lm_rowText" extends="fs25_settingsControlsListName">
            <textBold value="false"/>
            <textColor value="0.92 0.92 0.92 1"/>
            <textHighlightedColor value="0.92 0.92 0.92 1"/>
            <textFocusedColor value="0.12 0.12 0.12 1"/>
            <textSelectedColor value="0.12 0.12 0.12 1"/>
            <textFocusedSelectedColor value="0.12 0.12 0.12 1"/>
            <textHighlightedSelectedColor value="0.12 0.12 0.12 1"/>
        </Profile>

        <Profile name="lm_rowTextBold" extends="lm_rowText">
            <textBold value="true"/>
        </Profile>

        <Profile name="lm_rowTextMuted" extends="lm_rowText">
            <textColor value="0.65 0.65 0.65 1"/>
            <textHighlightedColor value="0.65 0.65 0.65 1"/>
        </Profile>

        <!-- Zahlen rechtsbündig. Die Textfelder sind (laut Spielprofil) 450px breit:
             position = gewünschter rechter Rand - 450 -->
        <Profile name="lm_rowTextRight" extends="lm_rowText">
            <textAlignment value="right"/>
        </Profile>

        <Profile name="lm_emptyText" extends="fs25_textDefault" with="anchorTopLeft">
            <size value="1200px 40px"/>
            <position value="50px -120px"/>
            <textAlignment value="left"/>
            <textSize value="20px"/>
            <textColor value="0.8 0.8 0.8 1"/>
        </Profile>
    </GUIProfiles>
</GUI>
